# 未設定時會使用本機 SQLite：backend/data.db（不會寫入 Supabase）
# Supabase：Project Settings → Database → Connection string → URI（密碼填進去）
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

FINMIND_TOKEN=your_finmind_token_here

# Optional mutation API key; unset allows requests during rollout.
API_KEY=

# FinMind process-level request limits
FINMIND_MAX_CONCURRENCY=2
FINMIND_MIN_INTERVAL_S=0.5
